{
  "name": "mui-country-code-selector",
  "version": "0.3.0",
  "private": false,
  "description": "A country code selector component",
  "author": "Jari Ikonen",
  "license": "MIT",
  "type": "module",
  "browser": "dist/mui-country-code-selector.js",
  "module": "dist/mui-country-code-selector.js",
  "main": "dist/mui-country-code-selector.js",
  "types": "dist/mui-country-code-selector.d.ts",
  "files": [
    "dist/mui-country-code-selector.js",
    "dist/mui-country-code-selector.d.ts",
    "dist/en-*.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jariikonen/mui-country-code-selector",
    "directory": "packages/mui-country-code-selector"
  },
  "keywords": [
    "telephone",
    "phone",
    "number",
    "country",
    "calling",
    "code",
    "input",
    "ITU-T E.164"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "create-docs": "mkdir -p etc && api-extractor run --local --verbose && api-documenter markdown --input-folder ./temp --output-folder ./docs",
    "ci-and-build": "pnpm --filter='mui-country-code-selector' i --frozen-lockfile && pnpm --filter='mui-country-code-selector' run build && pnpm --filter='mui-country-code-selector' run create-docs",
    "cleanup": "rm -rf ./dist && rm -rf ./docs && rm -rf ./node_modules && rm -rf ./temp"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@microsoft/api-documenter": "^7.26.32",
    "@microsoft/api-extractor": "^7.52.11",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "csstype": "^3.1.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-dom": "^1.52.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-react-x": "^1.52.6",
    "eslint-plugin-testing-library": "^7.6.6",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^7.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
