{
  "name": "demo-page",
  "version": "0.3.0",
  "private": false,
  "author": "Jari Ikonen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "convert-docs": "tsx docsToHTML && sh docsToHTML/fixLinks.sh",
    "ci-and-build": "pnpm --filter='demo-page' i --frozen-lockfile && pnpm --filter='demo-page' run convert-docs && pnpm --filter='demo-page' run build",
    "cleanup": "rm -rf ./dist && rm -rf ./node_modules && rm -rf ./public/docs",
    "rebuild-docs": "pnpm --filter='demo-page' run convert-docs && pnpm --filter='demo-page' run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.6",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "match-sorter": "^8.1.0",
    "mui-country-code-selector": "file:../mui-country-code-selector",
    "react-syntax-highlighter": "^15.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "markdown-it": "^14.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
